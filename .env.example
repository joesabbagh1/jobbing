# Shared secret the Grok bot sends in the `x-api-key` header when posting jobs.
# Generate one with: openssl rand -hex 32
INGEST_API_KEY=

# Airtable — where the Grok bot saves findings. The app pulls new rows automatically.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
# AIRTABLE_SYNC_MINUTES=5

# Optional: override the SQLite file location (default: data/jobbing.db)
# DATABASE_PATH=

# Indeed job alert emails, read by npm run indeed:alerts (a Gmail app password, not your real password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# France Travail job offers API (francetravail.io, "Offres d'emploi v2"); the search skips it when unset
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
