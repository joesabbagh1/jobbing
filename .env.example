# Shared secret the Grok bot sends in the `x-api-key` header when posting jobs.
# Generate one with: openssl rand -hex 32
INGEST_API_KEY=

# DeepSeek (used from step 4 onwards)
DEEPSEEK_API_KEY=

# Airtable — where the Grok bot saves findings. The app pulls new rows automatically.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
# AIRTABLE_SYNC_MINUTES=5

# Optional: override the SQLite file location (default: data/jobbing.db)
# DATABASE_PATH=
